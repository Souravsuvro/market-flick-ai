# Replace placeholders locally. Never commit real credentials.
MONGODB_URI="mongodb://localhost:27017/market_flick_ai"
OPENAI_API_KEY=""
PPLX_API_KEY=""
TAVILY_API_KEY=""
NVIDIA_API_KEY=""

# Authentication: generate a unique random secret of at least 32 bytes.
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Exact comma-separated frontend origins. Add the deployed frontend origin.
CORS_ORIGINS="http://localhost:3000"

# Email configuration
EMAIL_PROVIDER="smtp"
EMAIL_SENDER=""
EMAIL_SERVER="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
FRONTEND_URL="http://localhost:3000"

# Keep disabled in production.
SKIP_EMAIL_VERIFICATION="false"

# Qdrant configuration
QDRANT_URL=""
QDRANT_API_KEY=""
