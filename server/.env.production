# Production Environment Configuration
# IMPORTANT: Never commit real credentials to version control!
# Use secrets management system (AWS Secrets Manager, Azure Key Vault, etc.)

# MongoDB Configuration
MONGODB_URI=${MONGODB_URI_PROD}

# API Keys (load from secrets manager)
OPENAI_API_KEY=${OPENAI_API_KEY_PROD}
PPLX_API_KEY=${PPLX_API_KEY_PROD}
TAVILY_API_KEY=${TAVILY_API_KEY_PROD}
NVIDIA_API_KEY=${NVIDIA_API_KEY_PROD}

# JWT Configuration
JWT_SECRET_KEY=${JWT_SECRET_KEY_PROD}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
EMAIL_PROVIDER=ses
EMAIL_SENDER=noreply@marketflick.ai
AWS_SES_REGION=us-east-1

# Application Configuration
BASE_URL=https://api.marketflick.ai
ENVIRONMENT=production
DEBUG=false

# CORS Configuration (restrict to deployed frontend)
ALLOWED_ORIGINS=https://app.marketflick.ai,https://www.marketflick.ai

# Security
HTTPS_ONLY=true
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=/var/log/market-flick-ai

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Database
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT=30

# Cache
REDIS_URL=${REDIS_URL_PROD}
CACHE_TTL=3600
